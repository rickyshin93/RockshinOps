{
  "name": "rockshinops",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh scripts/mygo.sh dev",
    "build": "sh scripts/mygo.sh build",
    "generate": "sh scripts/mygo.sh generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:go": "sh scripts/go.sh test ./...",
    "test:web": "bun test tests",
    "build:website": "bun scripts/build-website.ts"
  },
  "dependencies": {
    "i18next": "26.5.11",
    "lucide": "1.61.0",
    "mygo-runtime": "0.6.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mygo-cli": "0.6.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "Free, open-source desktop system monitor for macOS, Windows and Linux",
  "license": "MIT",
  "author": "RockshinOps contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/rickyshin93/RockshinOps.git"
  },
  "packageManager": "bun@1.4.2"
}
