{
  "name": "localops",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh scripts/mygo.sh dev",
    "build": "sh scripts/mygo.sh build",
    "generate": "sh scripts/mygo.sh generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:go": "sh scripts/go.sh test ./...",
    "test:web": "bun test tests"
  },
  "dependencies": {
    "i18next": "26.5.11",
    "lucide": "1.61.0",
    "mygo-runtime": "0.6.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mygo-cli": "0.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "A local desktop system monitor with persistent menu bar metrics",
  "license": "MIT",
  "author": "LocalOps contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/rickyshin93/local-ops.git"
  },
  "packageManager": "bun@1.4.2"
}
