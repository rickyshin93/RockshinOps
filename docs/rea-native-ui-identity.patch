+func kernelLaunchTime(_ pid: Int32) throws -> Double {
+  var mib: [Int32] = [CTL_KERN, KERN_PROC, KERN_PROC_PID, pid]
+  var info = kinfo_proc()
+  var size = MemoryLayout<kinfo_proc>.size
+  let status = sysctl(&mib, u_int(mib.count), &info, &size, nil, 0)
+  guard status == 0, size == MemoryLayout<kinfo_proc>.size,
+    info.kp_proc.p_pid == pid, info.kp_proc.p_starttime.tv_sec > 0 else {
+    try fail("process-identity-unavailable", "Kernel process start identity is unavailable")
+  }
+  let start = info.kp_proc.p_starttime
+  return Double(start.tv_sec) + Double(start.tv_usec) / 1_000_000
+}
