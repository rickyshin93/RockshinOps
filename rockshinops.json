{
  "defaultOpenAtLogin": true,
  "defaultHideDockOnClose": false,
  "defaultLanguage": "system",
  "defaultUpdateUseSystemProxy": false,
  "updateIntervalSeconds": 86400,
  "defaultMenuBarItems": [
    "disk"
  ],
  "defaultSidebarTools": {
    "calculator": true,
    "clipboard": true
  },
  "sampleIntervalSeconds": 30,
  "metricsIntervalSeconds": 2,
  "deviceRefreshSeconds": 5,
  "wifiSignalThresholds": {
    "strongDbm": -67,
    "fairDbm": -70
  },
  "temperatureColorThresholds": {
    "mediumCelsius": 60,
    "highCelsius": 80
  },
  "processIntervalSeconds": 5,
  "historySeconds": 3600,
  "connectionTimeoutSeconds": 10,
  "connectionSampleIntervalSeconds": 1,
  "machineInfoTimeoutSeconds": 5,
  "powerAssertionIntervalSeconds": 10,
  "keepAwakeMinutes": [30, 60, 120, 180, 240, 300, 360, 420, 480, 540, 600, 660, 720, 1440],
  "keepAwakeExtendMinutes": 15,
  "clipboardHistory": {
    "pollMilliseconds": 350,
    "maxEntries": 100,
    "maxSnippets": 100,
    "maxItemBytes": 65536,
    "maxImageBytes": 67108864,
    "maxHistoryBytes": 268435456
  },
  "calculatorFormat": {
    "grouping": "auto",
    "decimalPlaces": 4
  },
  "launcher": {
    "defaultEnabled": false,
    "defaultFiles": true,
    "defaultShortcut": {
      "darwin": "Cmd+Space",
      "windows": "Alt+Space",
      "linux": "Alt+Space"
    },
    "fileRebuildMinutes": 60,
    "weChatPaths": ["Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files/*/msg/file"],
    "files": {
      "darwin": {
        "skipNames": ["node_modules", ".git", ".svn", ".hg", "__pycache__", ".venv", ".next", ".turbo", ".pnpm-store", "DerivedData", ".gradle"],
        "skipPaths": ["Library", ".Trash", ".cache", ".npm", ".bun", ".cargo", ".rustup", "go/pkg", ".m2", ".docker", ".orbstack", ".colima", ".local/share", ".vscode/extensions", ".cursor/extensions"],
        "include": [
          "Library/Mobile Documents/com~apple~CloudDocs"
        ]
      },
      "windows": {
        "skipNames": ["node_modules", ".git", ".svn", ".hg", "__pycache__", ".venv", ".next", ".turbo", ".pnpm-store", ".gradle"],
        "skipPaths": ["AppData", ".cache", ".npm", ".bun", ".cargo", ".rustup", "go/pkg", ".m2", ".docker", ".vscode/extensions", ".cursor/extensions"],
        "include": []
      },
      "linux": {
        "skipNames": ["node_modules", ".git", ".svn", ".hg", "__pycache__", ".venv", ".next", ".turbo", ".pnpm-store", ".gradle"],
        "skipPaths": [".cache", ".npm", ".bun", ".cargo", ".rustup", "go/pkg", ".m2", ".docker", ".local/share", ".vscode/extensions", ".cursor/extensions"],
        "include": []
      }
    }
  },
  "cleanupIdleDays": 30,
  "cleanupDownloadMinBytes": 100000000,
  "scanTargets": {
    "darwin": [
      {
        "name": "应用缓存",
        "path": "~/Library/Caches",
        "cleanup": "idle"
      },
      {
        "name": "应用日志",
        "path": "~/Library/Logs",
        "cleanup": "idle"
      },
      {
        "name": "下载文件",
        "path": "~/Downloads",
        "cleanup": "downloads"
      },
      {
        "name": "Xcode 构建缓存",
        "path": "~/Library/Developer/Xcode/DerivedData",
        "cleanup": "review"
      },
      {
        "name": "废纸篓",
        "path": "~/.Trash"
      }
    ],
    "windows": [
      {
        "name": "临时文件",
        "path": "~/AppData/Local/Temp",
        "cleanup": "idle"
      },
      {
        "name": "下载文件",
        "path": "~/Downloads",
        "cleanup": "downloads"
      }
    ],
    "linux": [
      {
        "name": "应用缓存",
        "path": "~/.cache",
        "cleanup": "idle"
      },
      {
        "name": "应用日志",
        "path": "~/.local/state"
      },
      {
        "name": "下载文件",
        "path": "~/Downloads",
        "cleanup": "downloads"
      },
      {
        "name": "废纸篓",
        "path": "~/.local/share/Trash/files"
      }
    ]
  },
  "menuBarManager": {
    "enabled": false,
    "alwaysHidden": false,
    "usePanel": true,
    "showOnHover": false,
    "hoverDelay": 0.2,
    "rehideDelay": 15,
    "revealCheckInterval": 0.5,
    "temporaryRevealSeconds": 15,
    "captureTimeoutSeconds": 5,
    "showAllOnDrag": true,
    "hideAppMenus": false,
    "secondaryMenu": false,
    "divider": "line",
    "dynamic": false,
    "light": {
      "tint": "none",
      "color": "#34465C",
      "shadow": false,
      "border": false,
      "shape": "none"
    },
    "dark": {
      "tint": "none",
      "color": "#34465C",
      "shadow": false,
      "border": false,
      "shape": "none"
    },
    "toggleHotkey": "",
    "searchHotkey": "",
    "panelHotkey": "",
    "menusHotkey": ""
  }
}
