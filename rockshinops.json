{
  "defaultOpenAtLogin": true,
  "defaultHideDockOnClose": false,
  "defaultLanguage": "system",
  "defaultUpdateUseSystemProxy": false,
  "updateIntervalSeconds": 86400,
  "defaultMenuBarItems": [
    "disk"
  ],
  "sampleIntervalSeconds": 30,
  "metricsIntervalSeconds": 2,
  "processIntervalSeconds": 5,
  "historySeconds": 3600,
  "connectionTimeoutSeconds": 10,
  "connectionSampleIntervalSeconds": 1,
  "machineInfoTimeoutSeconds": 5,
  "powerAssertionIntervalSeconds": 10,
  "launcher": {
    "defaultEnabled": false,
    "defaultFiles": true,
    "defaultShortcut": {
      "darwin": "Cmd+Space",
      "windows": "Alt+Space",
      "linux": "Alt+Space"
    },
    "fileRebuildMinutes": 60,
    "weChatPaths": ["Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files/*/msg/file"],
    "files": {
      "darwin": {
        "skipNames": ["node_modules", ".git", ".svn", ".hg", "__pycache__", ".venv", ".next", ".turbo", ".pnpm-store", "DerivedData", ".gradle"],
        "skipPaths": ["Library", ".Trash", ".cache", ".npm", ".bun", ".cargo", ".rustup", "go/pkg", ".m2", ".docker", ".orbstack", ".colima", ".local/share", ".vscode/extensions", ".cursor/extensions"],
        "include": [
          "Library/Mobile Documents/com~apple~CloudDocs"
        ]
      },
      "windows": {
        "skipNames": ["node_modules", ".git", ".svn", ".hg", "__pycache__", ".venv", ".next", ".turbo", ".pnpm-store", ".gradle"],
        "skipPaths": ["AppData", ".cache", ".npm", ".bun", ".cargo", ".rustup", "go/pkg", ".m2", ".docker", ".vscode/extensions", ".cursor/extensions"],
        "include": []
      },
      "linux": {
        "skipNames": ["node_modules", ".git", ".svn", ".hg", "__pycache__", ".venv", ".next", ".turbo", ".pnpm-store", ".gradle"],
        "skipPaths": [".cache", ".npm", ".bun", ".cargo", ".rustup", "go/pkg", ".m2", ".docker", ".local/share", ".vscode/extensions", ".cursor/extensions"],
        "include": []
      }
    }
  },
  "scanTargets": {
    "darwin": [
      {
        "name": "应用缓存",
        "path": "~/Library/Caches"
      },
      {
        "name": "应用日志",
        "path": "~/Library/Logs"
      },
      {
        "name": "下载文件",
        "path": "~/Downloads"
      },
      {
        "name": "废纸篓",
        "path": "~/.Trash"
      }
    ],
    "windows": [
      {
        "name": "临时文件",
        "path": "~/AppData/Local/Temp"
      },
      {
        "name": "下载文件",
        "path": "~/Downloads"
      }
    ],
    "linux": [
      {
        "name": "应用缓存",
        "path": "~/.cache"
      },
      {
        "name": "应用日志",
        "path": "~/.local/state"
      },
      {
        "name": "下载文件",
        "path": "~/Downloads"
      },
      {
        "name": "废纸篓",
        "path": "~/.local/share/Trash/files"
      }
    ]
  },
  "menuBarManager": {
    "enabled": false,
    "alwaysHidden": false,
    "usePanel": true,
    "showOnHover": false,
    "hoverDelay": 0.2,
    "rehideDelay": 15,
    "revealCheckInterval": 0.5,
    "temporaryRevealSeconds": 15,
    "captureTimeoutSeconds": 5,
    "showAllOnDrag": true,
    "hideAppMenus": false,
    "secondaryMenu": false,
    "divider": "line",
    "dynamic": false,
    "light": {
      "tint": "none",
      "color": "#34465C",
      "shadow": false,
      "border": false,
      "shape": "none"
    },
    "dark": {
      "tint": "none",
      "color": "#34465C",
      "shadow": false,
      "border": false,
      "shape": "none"
    },
    "toggleHotkey": "",
    "searchHotkey": "",
    "panelHotkey": "",
    "menusHotkey": ""
  }
}
